{
  // Place your global snippets here. Each snippet is defined under a snippet name and has a scope, prefix, body and
  // description. Add comma separated ids of the languages where the snippet is applicable in the scope field. If scope
  // is left empty or omitted, the snippet gets applied to all languages. The prefix is what is
  // used to trigger the snippet and the body will be expanded and inserted. Possible variables are:
  // $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders.
  // Placeholders with the same ids are connected.
  // Example:
  // "Print to console": {
  // 	"scope": "javascript,typescript",
  // 	"prefix": "log",
  // 	"body": [
  // 		"console.log('$1');",
  // 		"$2"
  // 	],
  // 	"description": "Log output to console"
  // }
  "datestamp": {
    "scope": "markdown,md",
    "prefix": "//date",
    "body": [
      "$CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE${CURRENT_DAY_NAME_SHORT/(Mon)|(Tue)|(Wed)|(Thu)|(Fri)|(Sat)|(Sun)/${1:+m}${2:+t}${3:+w}${4:+r}${5:+f}${6:+s}${7:+u}/}"
    ]
  },
  "console-log": {
    "scope": "javascript,typescript",
    "prefix": "clg",
    "body": [
      "console.log($1)",
      "$2"
    ]
  },
  "console-log-2": {
    "scope": "javascript,typescript",
    "prefix": "clg2",
    "body": [
      "console.log('$1')",
      "console.log($1)",
      "$2"
    ]
  },
  "define-spy-js": {
    "scope": "javascript,js",
    "prefix": "//def-spy",
    "body": [
      "const spy=(t,m)=>{if(m)console.log(m,': ',t);else console.log(t);return t;}"
    ]
  },
  "define-spy-ts": {
    "scope": "typescript,ts",
    "prefix": "//def-spy",
    "body": [
      "const spy=<T>(t:T,m?:string):T=>{if(m)console.log(m,': ',t);else console.log(t);return t;}"
    ]
  },
  "spy": {
    "scope": "javascript,js,typescript,ts",
    "prefix": "//spy",
    "body": [
      "spy($TM_SELECTED_TEXT$1)"
    ]
  },
  "freeze-browser": {
    "scope": "javascript,js,jsx,typescript,ts,tsx",
    "prefix": "freeze-browser",
    "body": [
      "setTimeout(() => {debugger}, 3000)"
    ]
  }
}
