
# Add these lines to the ~/.gitconfig:
  # [include]
  #     path = ~/dotfiles/.gitconfig
  # [core]
  #   excludesfile = ${DOTFILES_PATH}/.gitignore_global
  #   excludesfile = ~/dotfiles/.gitignore_global
  # [user]
  #   name = <Your Name>
  #   email = <Your Email>

[core]
  editor = code --wait
[color]
  ui = true
[diff]
  tool = vscode
[difftool "vscode"]
  cmd = code --wait --diff $LOCAL $REMOTE
[log]
  date=short
[merge]
  autostash = true
  conflictStyle = zdiff3 ## need git 2.35+ for zdiff3
[pull]
  rebase = true
  autostash = true
[push]
  autoSetupRemote = true
[rebase]
  autosquash = true
  autostash = true
  conflictStyle = zdiff3 ## need git 2.35+ for zdiff3
  updateRefs = true
[init]
  defaultBranch = main


##############
# formatting #
##############

[pretty]
  # you can define custom named formats here,
  # then pass them into the log command with:
  #   git log --pretty=customexample
  customexample = format:%C(yellow)%h %C(green)%ad %Cred%<(13)%d%Creset%s %Cpurplse%an
[format]
  # the default format:
  pretty = format:%C(yellow)%h %C(green)%ad %Creset%s %C(magenta)[%an] %C(auto)%d
  # you can access other formats using the pretty arg, eg:
  #   git log --pretty=fuller --date=iso

# fancy formats
# see https://git-scm.com/docs/pretty-formats
# ^some of these, like %as, don't work for some reason...
# see `git help log` for detailed help.
  # %H commit hash
  # %h abbreviated commit hash
  # %T tree hash
  # %t abbreviated tree hash
  # %P parent hashes
  # %p abbreviated parent hashes
  # %an author name
  # %aN author name (respecting .mailmap, see git-shortlog(1) or git-blame(1))
  # %ae author email
  # %aE author email (respecting .mailmap, see git-shortlog(1) or git-blame(1))
  # %ad author date (format respects --date= option)
  # %aD author date, RFC2822 style
  # %ar author date, relative
  # %at author date, UNIX timestamp
  # %ai author date, ISO 8601-like format
  # %aI author date, strict ISO 8601 format
  # %cn committer name
  # %cN committer name (respecting .mailmap, see git-shortlog(1) or git-blame(1))
  # %ce committer email
  # %cE committer email (respecting .mailmap, see git-shortlog(1) or git-blame(1))
  # %cd committer date (format respects --date= option)
  # %cD committer date, RFC2822 style
  # %cr committer date, relative %ct committer date, UNIX timestamp
  # %ci committer date, ISO 8601-like format
  # %cI committer date, strict ISO 8601 format
  # %d ref names, like the --decorate option of git-log(1)
  # %D ref names without the " (", ")" wrapping.
  # %S ref name given on the command line by which the commit was reached (like git log --source), only works with git log
  # %e encoding
  # %s subject
  # %f sanitized subject line, suitable for a filename
  # %b body
  # %B raw body (unwrapped subject and body)
  # %N commit notes
  # %GG raw verification message from GPG for a signed commit
  # %G? show "G" for a good (valid) signature, "B" for a bad signature, "U" for a good signature with unknown validity, "X" for a good signature that has expired, "Y" for a good signature made by an expired key, "R" for a good signature made by a revoked key, "E" if the signature cannot be checked (e.g. missing key) and "N" for no signature
  # %GS show the name of the signer for a signed commit
  # %GK show the key used to sign a signed commit
  # %GF show the fingerprint of the key used to sign a signed commit
  # %GS show the name of the signer for a signed commit
  # %GK show the key used to sign a signed commit
  # %GF show the fingerprint of the key used to sign a signed commit
  # %GP show the fingerprint of the primary key whose subkey was used to sign a signed commit
  # %gD reflog selector, e.g., refs/stash@{1} or refs/stash@{2 minutes ago}; the format follows the rules described for the -g option. The portion before the @ is the refname as # (so git log -g refs/heads/master would yield refs/heads/master@{0}).
  # %gd shortened reflog selector; same as %gD, but the refname portion is shortened for human readability (so refs/heads/master becomes just master).
  # %gn reflog identity name
  # %gN reflog identity name (respecting .mailmap, see git-shortlog(1) or git-blame(1))
  # %ge reflog identity email
  # %gE reflog identity email (respecting .mailmap, see git-shortlog(1) or git-blame(1))
  # %gs reflog subject
